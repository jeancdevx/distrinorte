# syntax=docker/dockerfile:1

FROM node:24-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/config packages/config
COPY packages/database packages/database
COPY packages/shared packages/shared
COPY packages/seed packages/seed
COPY data/demo data/demo
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @distrinorte/shared build \
  && pnpm --filter @distrinorte/database build

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 seed --ingroup nodejs

COPY --from=deps --chown=seed:nodejs /app/ .

USER seed

CMD ["sh", "-c", "pnpm db:ensure-databases && pnpm db:migrate:legacy-split && pnpm db:migrate:deploy && pnpm db:seed && pnpm seed:aws"]
