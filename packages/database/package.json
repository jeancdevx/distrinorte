  },
  "devDependencies": {
    "@distrinorte/config": "workspace:*",
    "@types/node": "25.9.3",
    "@types/pg": "8.20.0",
    "prisma": "7.8.0",
    "rolldown": "1.1.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.21.0"
  }
}
