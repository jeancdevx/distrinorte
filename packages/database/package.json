{
  "name": "@distrinorte/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./customers": {
      "types": "./src/customers.ts",
      "import": "./dist/customers.js",
      "default": "./dist/customers.js"
    },
    "./orders": {
      "types": "./src/orders.ts",
      "import": "./dist/orders.js",
      "default": "./dist/orders.js"
    },
    "./inventory": {
      "types": "./src/inventory.ts",
      "import": "./dist/inventory.js",
      "default": "./dist/inventory.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.generated.json && rolldown -c rolldown.config.ts",
    "db:generate": "prisma generate --schema prisma/customers/schema.prisma --config prisma/customers/prisma.config.ts && prisma generate --schema prisma/orders/schema.prisma --config prisma/orders/prisma.config.ts && prisma generate --schema prisma/inventory/schema.prisma --config prisma/inventory/prisma.config.ts",
    "db:ensure-databases": "tsx scripts/ensure-service-databases.ts",
    "db:migrate:deploy": "pnpm db:migrate:deploy:customers && pnpm db:migrate:deploy:orders && pnpm db:migrate:deploy:inventory",
    "db:migrate:deploy:customers": "prisma migrate deploy --schema prisma/customers/schema.prisma --config prisma/customers/prisma.config.ts",
    "db:migrate:deploy:orders": "prisma migrate deploy --schema prisma/orders/schema.prisma --config prisma/orders/prisma.config.ts",
    "db:migrate:deploy:inventory": "prisma migrate deploy --schema prisma/inventory/schema.prisma --config prisma/inventory/prisma.config.ts",
    "db:migrate:dev": "pnpm db:migrate:dev:customers && pnpm db:migrate:dev:orders && pnpm db:migrate:dev:inventory",
    "db:migrate:dev:customers": "prisma migrate dev --schema prisma/customers/schema.prisma --config prisma/customers/prisma.config.ts",
    "db:migrate:dev:orders": "prisma migrate dev --schema prisma/orders/schema.prisma --config prisma/orders/prisma.config.ts",
    "db:migrate:dev:inventory": "prisma migrate dev --schema prisma/inventory/schema.prisma --config prisma/inventory/prisma.config.ts",
    "db:seed": "tsx prisma/seed/index.ts",
    "lint": "oxlint src prisma prisma.config.ts scripts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@distrinorte/config": "workspace:*",
    "@types/node": "25.9.3",
    "@types/pg": "8.20.0",
    "prisma": "7.8.0",
    "rolldown": "1.1.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.21.0"
  }
}
