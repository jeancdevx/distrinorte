# Admin database — used only to CREATE the per-service databases (customers_db, etc.)
DATABASE_ADMIN_NAME=postgres

# Per-service logical databases (same RDS/Aurora host in dev)
DATABASE_NAME_CUSTOMERS=customers_db
DATABASE_NAME_ORDERS=orders_db
DATABASE_NAME_INVENTORY=inventory_db

# Connection (preferred over single DATABASE_URL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=distrinorte_admin
DATABASE_PASSWORD=changeme

# Optional full URLs per domain (override DATABASE_HOST composition)
# DATABASE_URL_CUSTOMERS=postgresql://user:pass@host:5432/customers_db?schema=public
# DATABASE_URL_ORDERS=postgresql://user:pass@host:5432/orders_db?schema=public
# DATABASE_URL_INVENTORY=postgresql://user:pass@host:5432/inventory_db?schema=public
