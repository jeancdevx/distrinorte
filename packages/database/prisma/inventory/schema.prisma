generator client {
  provider = "prisma-client"
  output   = "../../generated/inventory"
}

datasource db {
  provider = "postgresql"
}

model Warehouse {
  id        String   @id
  name      String
  isCentral Boolean  @default(false) @map("is_central")
  timezone  String   @default("America/Lima")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("warehouses")
}

model TransferMatrix {
  fromWarehouseId String @map("from_warehouse_id")
  toWarehouseId   String @map("to_warehouse_id")
  businessDays    Int    @map("business_days")
  cutoffHour      Int    @default(14) @map("cutoff_hour")

  @@id([fromWarehouseId, toWarehouseId])
  @@map("transfer_matrix")
}

model Inventory {
  sku         String
  warehouseId String   @map("warehouse_id")
  quantity    Int
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([sku, warehouseId])
  @@map("inventory")
}

model Reservation {
  id          String            @id @default(uuid())
  orderId     String            @map("order_id")
  sku         String
  warehouseId String            @map("warehouse_id")
  quantity    Int
  status      ReservationStatus @default(CONFIRMED)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("reservations")
}

enum ReservationStatus {
  CONFIRMED
  PENDING_TRANSFER
}

model StockTransfer {
  id                    String              @id @default(uuid())
  orderId               String              @map("order_id")
  destinationWarehouseId String             @map("destination_warehouse_id")
  status                StockTransferStatus @default(ALLOCATED)
  createdAt             DateTime            @default(now()) @map("created_at")
  completedAt           DateTime?           @map("completed_at")
  lines                 StockTransferLine[]

  @@index([orderId])
  @@map("stock_transfers")
}

model StockTransferLine {
  id              String        @id @default(uuid())
  transferId      String        @map("transfer_id")
  sku             String
  fromWarehouseId String        @map("from_warehouse_id")
  quantityBase    Int           @map("quantity_base")
  transfer        StockTransfer @relation(fields: [transferId], references: [id])

  @@map("stock_transfer_lines")
}

enum StockTransferStatus {
  ALLOCATED
  IN_TRANSIT
  COMPLETED
  FAILED
}
