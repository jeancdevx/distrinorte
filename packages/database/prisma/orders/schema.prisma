generator client {
  provider = "prisma-client"
  output   = "../../generated/orders"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id              String      @id @default(uuid())
  customerId      String      @map("customer_id")
  warehouseId     String      @map("warehouse_id")
  status          OrderStatus @default(PENDING)
  rejectionReason String?     @map("rejection_reason")
  idempotencyKey  String      @unique @map("idempotency_key")
  correlationId   String      @map("correlation_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  lines           OrderLine[]

  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderLine {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  sku      String
  quantity Int
  order    Order  @relation(fields: [orderId], references: [id])

  @@map("order_lines")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model CustomerSnapshot {
  customerId          String   @id @map("customer_id")
  taxId               String   @map("tax_id")
  assignedWarehouseId String   @map("assigned_warehouse_id")
  status              String
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("customer_snapshots")
}

model PriceSnapshot {
  sku              String   @id
  unitPriceNet     Decimal  @map("unit_price_net") @db.Decimal(12, 2)
  saleUnit         String   @default("UN") @map("sale_unit")
  unitsPerBaseUnit Int      @default(1) @map("units_per_base_unit")
  taxAffectation   String   @default("GRAVADO") @map("tax_affectation")
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("price_snapshots")
}
