{
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "css",
  "insertPragma": false,
  "jsxSingleQuote": true,
  "printWidth": 80,
  "proseWrap": "always",
  "quoteProps": "as-needed",
  "requirePragma": false,
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "importOrderParserPlugins": ["typescript", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0",
  "importOrderCaseSensitive": true,
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@distrinorte/(.*)$",
    "",
    "^@/constants.*$",
    "^@/correlation.*$",
    "^@/dto.*$",
    "^@/envelope.*$",
    "^@/types.*$",
    "^@/health.*$",
    "^@/modules.*$",
    "",
    "^@/(.*)$",
    "",
    "^(\\.\\./|\\./)constants.*$",
    "^(\\.\\./|\\./)correlation.*$",
    "^(\\.\\./|\\./)dto.*$",
    "^(\\.\\./|\\./)envelope.*$",
    "^(\\.\\./|\\./)types.*$",
    "^(\\.\\./|\\./)health.*$",
    "^(\\.\\./|\\./)modules.*$",
    "",
    "^(\\.\\./|\\./)generated.*$",
    "",
    "^[./]"
  ]
}
