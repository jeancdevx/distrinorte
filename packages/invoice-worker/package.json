{
  "name": "@distrinorte/invoice-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "package:lambda": "pnpm --filter @distrinorte/events build && pnpm build && node ./scripts/assert-lambda-bundle.mjs && mkdir -p dist && cd dist && zip -q -FS handler.zip index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1075.0",
    "@aws-sdk/client-eventbridge": "3.1075.0",
    "@aws-sdk/client-s3": "3.1075.0",
    "@aws-sdk/lib-dynamodb": "3.1075.0",
    "@aws-lambda-powertools/logger": "2.33.1",
    "@distrinorte/events": "workspace:*",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@distrinorte/config": "workspace:*",
    "@types/aws-lambda": "8.10.159",
    "@types/node": "25.9.3",
    "rolldown": "1.1.1",
    "typescript": "6.0.3"
  }
}
